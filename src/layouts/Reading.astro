---
import Base from './Base.astro';
import type { Lang } from '../lib/site';
import { pagefindAttrs, type SearchMarks } from '../lib/search';

interface Props {
  /** The document title. */
  title: string;
  /** The visible h1. */
  heading: string;
  description?: string;
  lang?: Lang;
  ogImage?: string;
  /** An index page (Events, Books, Quotes): column at the left gutter and a section-size title, like Blog and Photos. */
  section?: boolean;
  /** Index the article for the site search. */
  search?: SearchMarks;
}

const { heading, section = false, search, ...base } = Astro.props;
---

<Base {...base}>
  <article class:list={['reading', { section }]} {...pagefindAttrs(search)}>
    <header class="header">
      <h1 class="title" data-pagefind-meta="title">{heading}</h1>
      {Astro.slots.has('meta') && <p class="meta mono" data-pagefind-ignore><slot name="meta" /></p>}
    </header>
    <div class="prose"><slot /></div>
    <slot name="after" />
  </article>
</Base>

<style>
  .reading {
    max-width: calc(680px + 2 * var(--gutter));
    margin-inline: auto;
    padding: 72px var(--gutter) 96px;
  }

  .title {
    font-size: 36px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  /* Index pages share the section title of Blog and Photos and start at the gutter. */
  .section { margin-inline: 0; }

  .section .prose { margin-top: 16px; }

  .section .title {
    font-size: 28px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .meta {
    margin-top: 16px;
    color: var(--muted);
  }

  /* Underlined at rest, as the nav, so a category reads as a link and not as part of the date line. */
  .meta :global(a) {
    padding-bottom: 3px;
    border-bottom: 1px solid var(--muted);
    transition: color 120ms ease, border-color 120ms ease;
  }

  .meta :global(a:hover) {
    color: var(--fg);
    border-bottom-color: var(--fg);
  }

  .prose {
    margin-top: 48px;
    font-size: 17px;
    line-height: 1.6;
    overflow-wrap: break-word;
  }

  .prose > :global(* + *) { margin-top: 1.2em; }

  .prose :global(h2) {
    margin-top: 2em;
    font-size: 24px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .prose :global(h3) {
    margin-top: 1.75em;
    font-size: 19px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .prose :global(:is(h2, h3) + *) { margin-top: 0.6em; }

  .prose :global(:is(ul, ol)) { padding-left: 1.25em; }

  .prose :global(li + li),
  .prose :global(li > :is(ul, ol)) { margin-top: 0.4em; }

  .prose :global(strong) { font-weight: 600; }

  .prose :global(a:not(.video-embed)) {
    border-bottom: 1px solid var(--muted);
    transition: border-color 120ms ease;
  }

  .prose :global(a:not(.video-embed):hover) { border-bottom-color: var(--fg); }

  .prose :global(blockquote) {
    padding-left: 20px;
    border-left: 1px solid var(--muted);
    color: var(--muted);
  }

  .prose :global(blockquote > * + *) { margin-top: 0.8em; }

  .prose :global(blockquote footer) { font-size: 15px; }

  .prose :global(cite) { font-style: normal; }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .prose :global(pre) {
    overflow-x: auto;
    padding: 16px;
    border: 1px solid var(--rule);
    line-height: 1.5;
  }

  /* Never wider than the column, never stretched past the image's own width (a 413 px GIF). */
  .prose :global(img) {
    width: auto;
    max-width: 100%;
    height: auto;
  }

  .prose :global(iframe) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border: 0;
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--rule);
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }

  .prose :global(:is(th, td)) {
    padding: 8px 12px 8px 0;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: top;
  }

  @media (max-width: 719px) {
    .reading { padding-block: 40px 64px; }
    .title { font-size: 26px; }
    .section .title { font-size: 22px; }
    .prose { margin-top: 32px; }
  }
</style>
