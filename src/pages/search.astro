---
import { pageTitle } from '../lib/site';
import Base from '../layouts/Base.astro';
---

<Base title={pageTitle('Search')} description="Search the galleries, posts, quotes, events and books on olegs.be." lang="en" noindex>
  <section class="search wrap">
    <h1 class="heading">Search</h1>
    <p class="lead">Galleries, trips, posts, quotes, events and books.</p>
    <!-- Without JavaScript the form still reloads the page with ?q=, which then has nothing to run it. -->
    <form class="form" role="search" action="/search/" method="get">
      <label class="mono" for="q">Search the site</label>
      <input id="q" name="q" type="search" autocomplete="off" spellcheck="false" enterkeyhint="search" />
    </form>
    <p class="status" aria-live="polite">Type a place, a topic or a name.</p>
    <noscript><p class="status">Search needs JavaScript.</p></noscript>
    <div class="results"></div>
  </section>
</Base>

<script>
  // The index is written by `pagefind --site dist` after the Astro build, so it is loaded at runtime
  // from its absolute URL: Vite must not try to resolve or bundle it.
  interface Data {
    url: string;
    excerpt: string;
    meta: Record<string, string | undefined>;
  }
  interface Result { data(): Promise<Data> }
  interface Pagefind {
    init(): Promise<void>;
    mergeIndex(path: string, options: { language: string }): Promise<void>;
    search(term: string, options: { filters: Record<string, string> }): Promise<{ results: Result[] } | null>;
  }

  const GROUPS = [
    { type: 'gallery', label: 'Galleries' },
    { type: 'outdoors', label: 'Outdoors' },
    { type: 'post', label: 'Posts' },
    { type: 'other', label: 'Other' },
  ] as const;
  const PAGE = 20;
  const BUNDLE = '/pagefind/';
  const HINT = 'Type a place, a topic or a name.';

  const input = document.querySelector<HTMLInputElement>('#q')!;
  const form = input.form!;
  const status = document.querySelector<HTMLElement>('.search .status')!;
  const out = document.querySelector<HTMLElement>('.search .results')!;

  let loading: Promise<Pagefind> | undefined;
  // The page is English, so Pagefind loads the English index; the Italian posts live in their own
  // language index, merged in so one search covers both. mergeIndex skips a path the primary index's
  // path starts with ('/pagefind/'), so the same bundle is passed as a full URL.
  function load(): Promise<Pagefind> {
    loading ??= (async () => {
      const pagefind = (await import(/* @vite-ignore */ new URL(BUNDLE + 'pagefind.js', location.href).href)) as Pagefind;
      await pagefind.init();
      const entry = (await (await fetch(BUNDLE + 'pagefind-entry.json')).json()) as { languages: Record<string, unknown> };
      for (const language of Object.keys(entry.languages)) {
        if (language !== document.documentElement.lang) await pagefind.mergeIndex(new URL(BUNDLE, location.href).href, { language });
      }
      return pagefind;
    })();
    return loading;
  }

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  };

  // `YYYY-MM-DD` read as a local date, so the day never shifts with the time zone.
  const parseDate = (iso?: string): Date | undefined => {
    const [y, m, d] = (iso ?? '').split('-').map(Number);
    return y && m && d ? new Date(y, m - 1, d) : undefined;
  };
  const monthYear = (iso?: string) => {
    const date = parseDate(iso);
    return date ? new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric' }).format(date) : undefined;
  };
  // As on the Blog list.
  const fullDate = (iso?: string) => {
    const date = parseDate(iso);
    return date ? new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'long', year: 'numeric' }).format(date) : undefined;
  };

  function item(type: string, data: Data): HTMLLIElement {
    const li = el('li', `item ${type}`);
    const title = el('a', 'title', data.meta.title ?? data.url);
    title.href = data.url;
    if (type === 'gallery' || type === 'outdoors') {
      if (data.meta.image) {
        const img = el('img', 'cover');
        Object.assign(img, { src: data.meta.image, alt: '', width: 96, height: 72, loading: 'lazy', decoding: 'async' });
        li.append(img);
      } else {
        li.append(el('span', 'cover'));
      }
      const text = el('div', 'text');
      const meta = (type === 'outdoors'
        ? [data.meta.activity, monthYear(data.meta.date)]
        : [data.meta.country, data.meta.genre, monthYear(data.meta.date)]
      ).filter(Boolean).join(' · ');
      text.append(title, el('p', 'meta mono', meta));
      li.append(text);
      return li;
    }
    const date = type === 'post' ? fullDate(data.meta.date) : undefined;
    if (date) li.append(el('p', 'meta mono', date));
    // Pagefind escapes the page text and adds only <mark>.
    const excerpt = el('p', 'excerpt');
    excerpt.innerHTML = data.excerpt;
    li.append(title, excerpt);
    return li;
  }

  async function fill(list: HTMLUListElement, type: string, results: Result[]): Promise<void> {
    const rows = await Promise.all(results.map(async (result) => item(type, await result.data())));
    list.append(...rows);
  }

  function group(type: string, label: string, results: Result[]): HTMLElement {
    const section = el('section', 'group');
    const id = `group-${type}`;
    const heading = el('h2', 'group-heading mono', `${label} · ${results.length}`);
    heading.id = id;
    section.setAttribute('aria-labelledby', id);
    const list = el('ul', 'list');
    section.append(heading, list);
    if (results.length > PAGE) {
      const more = el('button', 'more mono', 'Show more');
      more.type = 'button';
      let shown = PAGE;
      more.addEventListener('click', async () => {
        const first = list.children.length;
        await fill(list, type, results.slice(shown, shown + PAGE));
        shown += PAGE;
        list.children[first]?.querySelector('a')?.focus();
        if (shown >= results.length) more.remove();
      });
      section.append(more);
    }
    return section;
  }

  let run = 0;
  async function search(term: string): Promise<void> {
    const current = ++run;
    const query = term.trim();
    if (!query) {
      out.replaceChildren();
      status.textContent = HINT;
      status.classList.remove('visually-hidden');
      return;
    }
    out.setAttribute('aria-busy', 'true');
    const pagefind = await load();
    const found = await Promise.all(GROUPS.map(({ type }) => pagefind.search(query, { filters: { type } })));
    if (current !== run) return; // a newer query has started
    const sections: HTMLElement[] = [];
    let total = 0;
    for (const [i, { type, label }] of GROUPS.entries()) {
      const results = found[i]?.results ?? [];
      if (results.length === 0) continue;
      total += results.length;
      const section = group(type, label, results);
      await fill(section.querySelector('ul')!, type, results.slice(0, PAGE));
      sections.push(section);
    }
    if (current !== run) return;
    out.replaceChildren(...sections);
    out.removeAttribute('aria-busy');
    status.textContent = total ? `${total} ${total === 1 ? 'result' : 'results'}` : `Nothing found for “${query}”.`;
    status.classList.toggle('visually-hidden', total > 0);
  }

  // The query lives in ?q=, so a search can be shared and survives a reload.
  function remember(term: string): void {
    const url = new URL(location.href);
    if (term.trim()) url.searchParams.set('q', term.trim());
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);
  }

  let timer: ReturnType<typeof setTimeout> | undefined;
  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(() => {
      remember(input.value);
      void search(input.value);
    }, 150);
  });
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    clearTimeout(timer);
    remember(input.value);
    void search(input.value);
  });

  input.value = new URLSearchParams(location.search).get('q') ?? '';
  input.focus();
  if (input.value.trim()) void search(input.value);
</script>

<style>
  .search {
    max-width: calc(760px + 2 * var(--gutter));
    padding-block: 72px 96px;
  }

  .heading {
    font-size: 28px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .lead {
    margin-top: 16px;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.5;
    max-width: 60ch;
  }

  .form { margin-top: 40px; }

  .form label {
    display: block;
    color: var(--muted);
  }

  .form input {
    display: block;
    width: 100%;
    margin-top: 8px;
    padding: 8px 0 10px;
    border: 0;
    border-bottom: 1px solid var(--muted);
    border-radius: 0;
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-size: 22px;
    line-height: 1.3;
    letter-spacing: -0.01em;
    appearance: none;
  }

  .form input::-webkit-search-decoration,
  .form input::-webkit-search-cancel-button { appearance: none; }

  /* A 2 px underline instead of the ring: the field is already a line. */
  .form input:focus-visible {
    outline: none;
    border-bottom-color: var(--fg);
    box-shadow: 0 1px 0 var(--fg);
  }

  .status {
    margin-top: 24px;
    color: var(--muted);
    font-size: 15px;
  }

  .results :global(.group) { margin-top: 48px; }

  .results :global(.group-heading) {
    padding-bottom: 12px;
    color: var(--muted);
  }

  .results :global(.list) {
    padding: 0;
    list-style: none;
  }

  .results :global(.item) {
    padding-block: 20px;
    border-top: 1px solid var(--rule);
  }

  .results :global(.item:last-child) { border-bottom: 1px solid var(--rule); }

  .results :global(.item.gallery),
  .results :global(.item.outdoors) {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    align-items: center;
    gap: 20px;
  }

  .results :global(.cover) {
    display: block;
    width: 96px;
    height: 72px;
    object-fit: cover;
    background: var(--rule);
  }

  .results :global(.title) {
    display: inline-block;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
    transition: color 120ms ease;
  }

  .results :global(.title:hover) { color: var(--muted); }

  .results :global(.meta) { color: var(--muted); }

  .results :global(.gallery .meta),
  .results :global(.outdoors .meta) { margin-top: 6px; }

  .results :global(.meta + .title) { margin-top: 8px; }

  .results :global(.excerpt) {
    margin-top: 6px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
    overflow-wrap: break-word;
  }

  .results :global(mark) {
    background: rgb(236 236 236 / 0.1);
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--muted);
    text-underline-offset: 3px;
  }

  .results :global(.more) {
    margin-top: 16px;
    padding: 6px 0 3px;
    border: 0;
    border-bottom: 1px solid var(--muted);
    background: none;
    color: var(--fg);
    cursor: pointer;
    transition: border-color 120ms ease;
  }

  .results :global(.more:hover) { border-bottom-color: var(--fg); }

  @media (max-width: 719px) {
    .search { padding-block: 40px 64px; }
    .heading { font-size: 22px; }
    .form input { font-size: 19px; }
  }
</style>
