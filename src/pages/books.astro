---
import { pageTitle } from '../lib/site';
import Reading from '../layouts/Reading.astro';
import { books } from '../lib/books';
import { renderInline } from '../lib/markdown';
---

<Reading section search={{ type: 'other' }} title={pageTitle('Books')} heading="Books" description="Books Olegs Belousovs has read: favourites on product, design and work, and a mixed shelf." lang="en">
  <p class="lead">Books I have read and keep on my shelf: the favourites first, then a mixed shelf.</p>
  <div class="books">
    {books.map(({ title, entries }) => {
      const items = entries.map((entry) => <li set:html={renderInline(entry)} />);
      return (
        <section class="group">
          <h2 class="section mono">{title}</h2>
          {title === 'Favourite Books' ? <ol reversed class="entries numbered">{items}</ol> : <ul class="entries">{items}</ul>}
        </section>
      );
    })}
  </div>
</Reading>

<style>
  .lead { color: var(--muted); margin: 0 0 40px; }

  .books .group { padding-block: 24px; border-top: 1px solid var(--rule); }

  .books .group:last-child { border-bottom: 1px solid var(--rule); }

  .books h2.section {
    margin: 0;
    color: var(--muted);
    font-size: 11px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.08em;
  }

  .books .entries {
    margin-top: 16px;
    padding: 0;
    list-style: none;
    font-size: 15px;
    line-height: 1.5;
  }

  .books .entries.numbered {
    padding-left: 3em;
    list-style: decimal;
  }

  .books .entries li + li { margin-top: 8px; }

  .books .entries li::marker {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .books .entries :global(em) {
    color: var(--muted);
    font-style: normal;
  }
</style>
