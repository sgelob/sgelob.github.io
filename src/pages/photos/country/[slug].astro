---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import PhotosHeader from '../../../components/PhotosHeader.astro';
import GalleryGrid from '../../../components/GalleryGrid.astro';
import { getGalleries, getGalleriesBy } from '../../../lib/collections';
import { countries, type Term } from '../../../lib/taxonomies';

// Only countries with at least one gallery get a page; the rest of taxonomies.yaml is for the trips.
export const getStaticPaths = (async () => {
  const galleries = await getGalleries();
  return countries
    .filter((c) => galleries.some((g) => g.data.country === c.slug))
    .map((country) => ({ params: { slug: country.slug }, props: { country } }));
}) satisfies GetStaticPaths;

interface Props {
  country: Term;
}

const { country } = Astro.props;
const galleries = await getGalleriesBy('country', country.slug);
---

<Base title={`${country.name} — Photos — olegs`}>
  <PhotosHeader heading={country.name} />
  <GalleryGrid galleries={galleries} />
</Base>
