---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import SectionLabel from '../components/SectionLabel.astro';
import PostList from '../components/PostList.astro';
import QuoteOfTheDay from '../components/QuoteOfTheDay.astro';
import TripGrid from '../components/TripGrid.astro';
import { getGalleries, getPosts, getTrips } from '../lib/collections';
import { home, leadParagraphs, pickFeatured } from '../lib/home';
import { renderInline } from '../lib/markdown';
import { SITE } from '../lib/site';

const about = await getEntry('pages', 'about');
if (!about) throw new Error('src/content/pages/about.md is missing: the home intro is read from it');
const intro = leadParagraphs(about.body ?? '').map(renderInline);

const galleries = await getGalleries();
const posts = await getPosts();
const trips = await getTrips();
const featured = pickFeatured(galleries, home.featuredGalleries);
// Not About's seoTitle: the home and /about/ need different titles.
const title = `${SITE.author} – ${SITE.description}`;

---

<Base title={title} description={about.data.seoDescription} lang="en">
  <section class="intro wrap">
    <h1 class="visually-hidden">{SITE.author}</h1>
    {/* The sections are linked from the bio itself; the nav and the footer carry the rest. */}
    {intro.map((html) => <p class="lead" set:html={html} />)}
  </section>

  <QuoteOfTheDay />

  <section aria-labelledby="home-photos">
    <SectionLabel id="home-photos" title="Photos" href="/photos/" link={`All ${galleries.length} galleries`} />
    <GalleryGrid galleries={featured} />
  </section>

  {trips.length > 0 && (
    <section aria-labelledby="home-outdoors">
      <SectionLabel id="home-outdoors" title="Outdoors" href="/outdoors/" link={`All ${trips.length} ${trips.length === 1 ? 'trip' : 'trips'}`} />
      <TripGrid trips={trips.slice(0, 4)} />
    </section>
  )}

  <section class="blog" aria-labelledby="home-blog">
    <SectionLabel id="home-blog" title="Blog" href="/blog/" link={`All ${posts.length} posts`} />
    <PostList posts={posts.slice(0, 3)} embedded />
  </section>
</Base>

<style>
  /* Less below than between the sections: the bio ends in text, not in a grid. */
  .intro { padding-block: 72px 56px; }

  .lead {
    max-width: 900px;
    font-size: 30px;
    font-weight: 400;
    line-height: 1.22;
    letter-spacing: -0.015em;
  }

  .lead + .lead {
    margin-top: 0.6em;
    color: var(--muted);
  }

  .lead :global(a) {
    border-bottom: 1px solid currentColor;
    transition: color 120ms ease;
  }

  .lead :global(a:hover) { color: var(--fg); }

  @media (max-width: 719px) {
    .intro { padding-block: 40px 40px; }
    .lead { font-size: 22px; }
  }
</style>
