---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import SectionLabel from '../components/SectionLabel.astro';
import PostList from '../components/PostList.astro';
import { getGalleries, getPosts } from '../lib/collections';
import { home, leadParagraphs, pickFeatured } from '../lib/home';
import { renderInline } from '../lib/markdown';
import { SITE } from '../lib/site';

const about = await getEntry('pages', 'about');
if (!about) throw new Error('src/content/pages/about.md is missing: the home intro is read from it');
const intro = leadParagraphs(about.body ?? '').map(renderInline);

const galleries = await getGalleries();
const posts = await getPosts();
const featured = pickFeatured(galleries, home.featuredGalleries);
// Not About's seoTitle: the home and /about/ need different titles.
const title = `${SITE.author} – ${SITE.description}`;

const links = [
  { label: 'Events', href: '/events/' },
  { label: 'Books', href: '/books/' },
  { label: 'Quotes', href: '/quotes/' },
  { label: 'Email', href: SITE.mailto },
];
---

<Base title={title} description={about.data.seoDescription} lang="en">
  <section class="intro wrap">
    <h1 class="visually-hidden">{SITE.author}</h1>
    {intro.map((html) => <p class="lead" set:html={html} />)}
    <ul class="links mono">
      {links.map(({ label, href }) => <li><a href={href}>{label} <span aria-hidden="true">↗</span></a></li>)}
    </ul>
  </section>

  <section aria-labelledby="home-photos">
    <SectionLabel id="home-photos" title="Photos" href="/photos/" link={`All ${galleries.length} galleries`} />
    <GalleryGrid galleries={featured} />
  </section>

  <section class="blog" aria-labelledby="home-blog">
    <SectionLabel id="home-blog" title="Blog" href="/blog/" link={`All ${posts.length} posts`} />
    <PostList posts={posts.slice(0, 3)} embedded />
  </section>
</Base>

<style>
  .intro { padding-block: 72px 96px; }

  .lead {
    max-width: 900px;
    font-size: 30px;
    font-weight: 400;
    line-height: 1.22;
    letter-spacing: -0.015em;
  }

  .lead + .lead {
    margin-top: 0.6em;
    color: var(--muted);
  }

  .lead :global(a) {
    border-bottom: 1px solid currentColor;
    transition: color 120ms ease;
  }

  .lead :global(a:hover) { color: var(--fg); }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    margin-top: 48px;
    padding: 0;
    list-style: none;
  }

  /* 6 px above the text, cancelled by the margin, makes a 24 px target without moving the row. */
  .links a {
    display: inline-block;
    padding: 6px 0 3px;
    margin-top: -6px;
    border-bottom: 1px solid var(--rule);
    transition: border-color 120ms ease;
  }

  .links a:hover { border-bottom-color: currentColor; }

  .blog { padding-bottom: 96px; }

  @media (max-width: 719px) {
    .intro { padding-block: 40px 64px; }
    .lead { font-size: 22px; }
    .links { margin-top: 32px; gap: 10px 20px; }
  }
</style>
