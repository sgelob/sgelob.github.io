---
import { getEntry } from 'astro:content';
import Reading from '../layouts/Reading.astro';
import QuoteList from '../components/QuoteList.astro';
import { groupByAuthor, quotes } from '../lib/quotes';

const page = await getEntry('pages', 'quotes');
if (!page) throw new Error('src/content/pages/quotes.md is missing');
---

<Reading
  title={page.data.seoTitle ?? `${page.data.title} — olegs`}
  heading="Favourite quotes"
  description={page.data.seoDescription ?? 'Inspirational quotes on life, design and work, collected by author.'}
  lang={page.data.lang}
>
  <p class="lead">Words on life, design and work that stayed with me over the years, collected by author.</p>
  <QuoteList quotes={quotes} />
</Reading>

<style>
  .lead { color: var(--muted); margin: 0 0 32px; }
</style>
