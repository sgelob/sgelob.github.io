---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/collections';

const page = await getEntry('pages', 'blog');
const posts = await getPosts();
---

<Base title={page?.data.seoTitle ?? 'Blog — olegs'} description={page?.data.seoDescription} lang="it">
  <PostList posts={posts} heading="Blog" lead={'Appunti su web performance, meetup e prodotto, dal 2016. <span lang="en">The posts are in Italian.</span>'} />
</Base>

