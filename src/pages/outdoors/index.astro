---
import { pageTitle } from '../../lib/site';
import Base from '../../layouts/Base.astro';
import OutdoorsIndex from '../../components/OutdoorsIndex.astro';
import { getTrips } from '../../lib/collections';
import { OUTDOORS_LEAD } from '../../lib/outdoors';

const trips = await getTrips();
---

<Base title={pageTitle('Outdoors')} description={OUTDOORS_LEAD}>
  <OutdoorsIndex trips={trips} filter="all" />
</Base>
