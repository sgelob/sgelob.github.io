---
import { pageTitle } from '../../../lib/site';
import Base from '../../../layouts/Base.astro';
import OutdoorsIndex from '../../../components/OutdoorsIndex.astro';
import { getTripsBy } from '../../../lib/collections';
import { OUTDOORS_LEAD } from '../../../lib/outdoors';

const trips = await getTripsBy('hike');
---

<Base title={pageTitle('Hikes', 'Outdoors')} description={OUTDOORS_LEAD}>
  <OutdoorsIndex trips={trips} filter="hikes" />
</Base>
