---
import { pageTitle } from '../../../lib/site';
import Base from '../../../layouts/Base.astro';
import OutdoorsIndex from '../../../components/OutdoorsIndex.astro';
import { getTripsBy } from '../../../lib/collections';
import { RIDES_LEAD } from '../../../lib/outdoors';

const trips = await getTripsBy('ride');
---

<Base title={pageTitle('Rides', 'Outdoors')} description={RIDES_LEAD}>
  <OutdoorsIndex trips={trips} filter="rides" />
</Base>
