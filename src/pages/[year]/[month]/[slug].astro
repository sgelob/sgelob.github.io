---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Reading from '../../../layouts/Reading.astro';
import Redirect from '../../../components/Redirect.astro';
import { getPosts, neighbours, postPath, type Post } from '../../../lib/collections';
import { originalUrl } from '../../../lib/images';
import { redirectsUnder } from '../../../lib/redirects';
import { formatDate, isoDate, pageTitle } from '../../../lib/site';
import { categoryName } from '../../../lib/taxonomies';
import VideoEmbeds from '../../../components/VideoEmbeds.astro';
import { hasEmbedFacade } from '../../../lib/video-embeds';

// getStaticPaths runs isolated from the rest of the frontmatter: everything it uses lives inside it.
export const getStaticPaths = (async () => {
  const POST_URL = /^\/(\d{4})\/(\d{2})\/([^/]+)\/$/;
  const paramsOf = (path: string) => {
    const [, year, month, slug] = POST_URL.exec(path) ?? [];
    return year && month && slug ? { year, month, slug } : undefined;
  };
  const posts = await getPosts();
  // Old slugs are written as WordPress served them, raw Unicode included.
  const redirects = redirectsUnder('/').flatMap(({ from, to }) => {
    const params = paramsOf(from);
    return params ? [{ params, props: { redirectTo: to } }] : [];
  });
  return [
    ...posts.map((post) => ({ params: paramsOf(postPath(post))!, props: { post, ...neighbours(posts, post.id) } })),
    ...redirects,
  ];
}) satisfies GetStaticPaths;

type Props =
  | { post: Post; prev?: Post; next?: Post; redirectTo?: undefined }
  | { redirectTo: string; post?: undefined };

const props = Astro.props as Props;
const post = props.post;
const { Content } = post ? await render(post) : { Content: undefined };
// The pager speaks the post's language: its name and the hidden older/newer prefixes.
const pager = post?.data.lang === 'it'
  ? { label: 'Altri articoli', older: 'Articolo precedente', newer: 'Articolo successivo' }
  : { label: 'More posts', older: 'Older post', newer: 'Newer post' };
---

{props.redirectTo !== undefined ? (
  <Redirect to={props.redirectTo} />
) : post && Content && (
  <Reading
    title={pageTitle(post.data.seoTitle ?? post.data.title)}
    heading={post.data.title}
    description={post.data.seoDescription ?? post.data.excerpt}
    lang={post.data.lang}
    ogImage={post.data.cover && originalUrl(post.data.cover)}
    search={{
      type: 'post',
      meta: {
        date: isoDate(post.data.date),
        // Post covers have no recorded size, so a variant may not exist: the original always does.
        image: post.data.cover && originalUrl(post.data.cover),
        excerpt: post.data.excerpt,
      },
    }}
  >
    <Fragment slot="meta">
      <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date, post.data.lang)}</time>
      {post.data.categories.map((slug) => (
        <> · <a href={`/category/${slug}/`}>{categoryName(slug)}</a></>
      ))}
    </Fragment>
    <Content />
    {hasEmbedFacade(post?.body) && <VideoEmbeds />}
    <nav class="pager mono" aria-label={pager.label} slot="after" data-pagefind-ignore>
      {props.next ? <a href={postPath(props.next)} rel="next"><span aria-hidden="true">←</span> <span class="visually-hidden">{pager.older}: </span>{props.next.data.title}</a> : <span></span>}
      {props.prev && <a href={postPath(props.prev)} rel="prev"><span class="visually-hidden">{pager.newer}: </span>{props.prev.data.title} <span aria-hidden="true">→</span></a>}
    </nav>
  </Reading>
)}

<style>
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 72px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }

  .pager a {
    max-width: 48%;
    transition: color 120ms ease;
  }

  .pager a:hover { color: var(--muted); }

  .pager [rel='prev'] { text-align: right; }
</style>
