---
// PhotoSwipe for the `.justified` grid, loaded on the first click so the page ships no lightbox code up front.
---

<script>
  // `?url`, not a CSS import: Astro would otherwise link the stylesheet on every gallery page up front.
  import styleUrl from 'photoswipe/style.css?url';

  type Lightbox = import('photoswipe/lightbox').default;

  /** Adds the stylesheet once; a link that failed is removed, so a later click tries again. */
  function loadStyle(): Promise<unknown> {
    const existing = document.querySelector<HTMLLinkElement>(`link[href="${styleUrl}"]`);
    if (existing?.sheet) return Promise.resolve();
    existing?.remove();
    const link = Object.assign(document.createElement('link'), { rel: 'stylesheet', href: styleUrl });
    const loaded = new Promise((resolve, reject) => {
      link.onload = resolve;
      link.onerror = () => {
        link.remove();
        reject(new Error(`stylesheet ${styleUrl} failed to load`));
      };
    });
    document.head.append(link);
    return loaded;
  }

  /** Both PhotoSwipe chunks and the stylesheet, all fetched before anything opens. */
  async function load(): Promise<Lightbox> {
    const [{ default: PhotoSwipeLightbox }, { default: PhotoSwipe }] = await Promise.all([
      import('photoswipe/lightbox'),
      import('photoswipe'),
      loadStyle(),
    ]);
    const lightbox = new PhotoSwipeLightbox({
      gallery: '.justified',
      children: 'a.ph',
      pswpModule: PhotoSwipe,
      // A solid backdrop: at the default 0.8 the page's text shows through behind the caption.
      bgOpacity: 1,
      // Become each button's title and aria-label.
      arrowPrevTitle: 'Previous photo',
      arrowNextTitle: 'Next photo',
      closeTitle: 'Close (Esc)',
      zoomTitle: 'Zoom',
    });
    // PhotoSwipe's role="dialog" has no name: `uiRegister` fires once the root element exists,
    // before it is added to the page, so the dialog is named when focus moves into it.
    lightbox.on('uiRegister', () => {
      const root = lightbox.pswp?.element;
      root?.setAttribute('aria-label', 'Photo viewer');
      root?.setAttribute('aria-modal', 'true');
    });
    // The counter ("3 / 81") is updated on every `change`: as a live region, ← and → are announced.
    // `uiElement` filters each UI element as PhotoSwipe adds it to the dialog.
    lightbox.addFilter('uiElement', (element, data) => {
      if (data.name === 'counter') {
        element.setAttribute('aria-live', 'polite');
        element.setAttribute('aria-atomic', 'true');
      }
      return element;
    });
    // The photo's size comes from its grid img, which declares it anyway: a data-pswp-width/height
    // pair on every link as well would push an 80-photo gallery past its 50 KB budget.
    lightbox.addFilter('domItemData', (item, _element, link) => {
      const img = link.querySelector('img');
      item.width = item.w = Number(img?.getAttribute('width')) || 0;
      item.height = item.h = Number(img?.getAttribute('height')) || 0;
      // The description goes on the full-size img too; the "Photo n" fallback is not a description.
      const alt = img?.getAttribute('alt') ?? '';
      item.alt = /^Photo \d+$/.test(alt) ? '' : alt;
      return item;
    });
    // The caption: the photo's description under the image, updated as the slides change.
    lightbox.on('uiRegister', () => {
      lightbox.pswp?.ui?.registerElement({
        name: 'caption',
        className: 'lb-caption mono',
        appendTo: 'root',
        onInit: (element, pswp) => {
          pswp.on('change', () => {
            element.textContent = pswp.currSlide?.data.alt ?? '';
          });
        },
      });
    });
    // Deep links: the open photo is in the hash (#photo-12), so a link to it opens the lightbox on
    // load, and closing it is a history entry, so Back closes the photo instead of leaving the page.
    let opened = false;
    lightbox.on('change', () => {
      const hash = `#photo-${(lightbox.pswp?.currIndex ?? 0) + 1}`;
      if (opened) {
        history.replaceState({ photo: true }, '', hash);
      } else {
        opened = true;
        // Landed on #photo-n: the page itself becomes the entry below, so Back still closes.
        if (location.hash) history.replaceState(null, '', location.pathname + location.search);
        history.pushState({ photo: true }, '', hash);
      }
    });
    lightbox.on('close', () => {
      opened = false;
      // Closed with Esc, the button or a tap: drop the hash entry so Back does not reopen it.
      if (history.state?.photo) history.back();
    });
    window.addEventListener('popstate', () => {
      // Back (or forward) while open: close the photo. PhotoSwipe ignores a close while closing.
      if (!history.state?.photo) lightbox.pswp?.close();
    });
    lightbox.init();
    return lightbox;
  }

  const grid = document.querySelector<HTMLElement>('.justified');
  let state: 'idle' | 'loading' | 'ready' = 'idle';

  /** Loads PhotoSwipe once and opens the photo at `index`; `fallback` runs when loading fails. */
  function open(index: number, fallback?: () => void): void {
    if (state === 'loading') return;
    state = 'loading';
    load().then(
      (lightbox) => {
        state = 'ready';
        lightbox.loadAndOpen(index);
      },
      () => {
        state = 'idle';
        fallback?.();
      },
    );
  }

  // Once initialised, PhotoSwipe handles the clicks itself: this only covers the first one.
  grid?.addEventListener('click', (event) => {
    if (state === 'ready' || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = (event.target as Element).closest<HTMLAnchorElement>('a.ph');
    if (!link) return;
    event.preventDefault();
    // Any of the three requests in load() failed (offline, a missing chunk or stylesheet): nothing
    // has opened, so follow the plain link to the original. Photos that fail inside the open
    // lightbox are PhotoSwipe's to report.
    open([...grid.querySelectorAll('a.ph')].indexOf(link), () => { window.location.href = link.href; });
  });

  // A deep link to a photo (#photo-12) opens it on load; an index past the last photo is ignored.
  const linked = Number(/^#photo-(\d+)$/.exec(location.hash)?.[1]);
  if (grid && linked >= 1 && linked <= grid.querySelectorAll('a.ph').length) open(linked - 1);
</script>

<!-- Global: the caption is rendered by PhotoSwipe outside any scoped markup. -->
<style is:global>
  .pswp .lb-caption {
    position: absolute;
    inset: auto 0 0;
    padding: 12px var(--gutter) max(12px, env(safe-area-inset-bottom));
    color: var(--muted);
    text-align: center;
    text-wrap: balance;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.5));
    pointer-events: none;
  }

  .pswp .lb-caption:empty { display: none; }
</style>
