---
import Hero from './Hero.astro';
import { coverSize, type Gallery } from '../lib/paths';
import { formatMonthYear } from '../lib/site';
import { countryName, genreName } from '../lib/taxonomies';

interface Props {
  gallery: Gallery;
}

const { gallery } = Astro.props;
const { title, cover, country, genre, date, photos, darkHeader } = gallery.data;
const size = coverSize(gallery);
// The cover is decorative when the grid shows it again; otherwise this is its only appearance.
const coverAlt = photos.some((photo) => photo.src === cover) ? '' : title;
---

<Hero title={title} cover={cover} width={size?.width} height={size?.height} coverAlt={coverAlt} darkHeader={darkHeader}>
  <a href={`/photos/country/${country}/`}>{countryName(country)}</a>{' '}
  <a href={`/photos/genre/${genre}/`}>{genreName(genre)}</a>{' '}
  <span>{formatMonthYear(date, 'en')}</span>{' '}
  <span>{photos.length} photos</span>
</Hero>
