---
import Pic from './Pic.astro';
import { coverSize, type Gallery } from '../lib/paths';
import { formatMonthYear } from '../lib/site';
import { countryName, genreName } from '../lib/taxonomies';

interface Props {
  gallery: Gallery;
}

const { gallery } = Astro.props;
const { title, cover, country, genre, date, photos, darkHeader } = gallery.data;
const size = coverSize(gallery);
---

<header class="hero" data-dark-header={darkHeader ? '' : undefined}>
  <Pic
    src={cover}
    width={size?.width}
    height={size?.height}
    alt=""
    sizes="100vw"
    maxWidth={1600}
    loading="eager"
  />
  <div class="caption wrap">
    <h1 class="title">{title}</h1>
    <p class="meta mono">
      <a href={`/photos/country/${country}/`}>{countryName(country)}</a>
      <a href={`/photos/genre/${genre}/`}>{genreName(genre)}</a>
      <span>{formatMonthYear(date, 'en')}</span>
      <span>{photos.length} photos</span>
    </p>
  </div>
</header>

<style>
  .hero {
    --scrim-top: 0.45;
    --scrim-bottom: 0.65;
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 640px;
    padding-top: 96px; /* room for the nav floating over the cover, so a long title never runs under it */
    overflow: hidden;
    background: var(--rule);
  }

  .hero :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* A light overall tint plus two scrims: under the nav at the top and under the title and meta at
     the bottom, so light text stays readable on a light cover. `darkHeader` marks covers that are
     light where the text sits: both scrims get stronger. */
  .hero[data-dark-header] {
    --scrim-top: 0.6;
    --scrim-bottom: 0.8;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(0 0 0 / var(--scrim-top)), transparent 40%),
      linear-gradient(to top, rgb(0 0 0 / var(--scrim-bottom)), transparent 55%),
      rgb(0 0 0 / 0.15);
  }

  .caption {
    position: relative;
    z-index: 1;
    padding-block-end: 40px;
  }

  .title {
    font-size: 44px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .meta a { border-bottom: 1px solid transparent; }

  .meta a:hover,
  .meta a:focus-visible { border-bottom-color: currentColor; }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin-top: 16px;
  }

  @media (max-width: 719px) {
    .hero { min-height: 60vw; padding-top: 72px; }
    .caption { padding-block-end: 20px; }
    .title { font-size: 28px; }
    .meta { margin-top: 10px; }
  }
</style>
