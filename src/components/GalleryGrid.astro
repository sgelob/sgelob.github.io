---
import GalleryCard from './GalleryCard.astro';
import type { Gallery } from '../lib/paths';

interface Props {
  galleries: Gallery[];
  /** One grid among several on a page: a shorter gap below, the page adds the rest. */
  embedded?: boolean;
}

const { galleries, embedded = false } = Astro.props;
---

{galleries.length === 0 ? (
  <p class="empty mono wrap">No galleries yet.</p>
) : (
  <ul class:list={["grid wrap", { embedded }]}>
    {galleries.map((gallery) => (
      <li><GalleryCard gallery={gallery} /></li>
    ))}
  </ul>
)}

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    padding-block: 0 96px;
    list-style: none;
  }

  .grid.embedded { padding-bottom: 64px; }

  @media (min-width: 480px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1100px) {
    .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .empty {
    padding-block: 0 96px;
    color: var(--muted);
  }
</style>
