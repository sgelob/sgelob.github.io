---
import Pic from './Pic.astro';
import { lightboxUrl, originalUrl } from '../lib/images';

interface Photo {
  src: string;
  width: number;
  height: number;
  /** A description of the photo, when the gallery has one. */
  alt?: string;
}

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;
const ratio = (p: Photo): number => Math.round((p.width / p.height) * 1e4) / 1e4;
---

<!-- href is the original, the no-JS fallback; PhotoSwipe opens data-pswp-src, the 1600 variant, when
     the original is wider than that, and takes the size from the img (see Lightbox.astro). -->
<div class="justified wrap">
  {photos.map((photo, i) => (
    <a
      class="ph"
      href={originalUrl(photo.src)}
      data-pswp-src={lightboxUrl(photo.src, photo.width)}
      style={`--r:${ratio(photo)}`}
    >
      <Pic
        src={photo.src}
        width={photo.width}
        height={photo.height}
        alt={photo.alt ?? `Photo ${i + 1}`}
        indexAlt={photo.alt !== undefined}
        sizes="(min-width: 1100px) 33vw, 50vw"
        maxWidth={960}
      />
    </a>
  ))}
  <span class="spacer" style="flex-grow: 10000"></span>
</div>

<!-- Global but namespaced under .justified: a scoped style would stamp a data-astro-cid attribute
     on every item, and a gallery of 80 photos has to stay under 50 KB. -->
<style is:global>
  /* Justified rows without JS: every item grows in proportion to its aspect ratio, so a row
     shares one height; the spacer soaks up the last row's slack so it is not stretched.
     --basis is the height before growing, so it sits below the ~300px (mobile ~180px) target:
     at 300px, three landscape photos no longer fit a 1344px row and two grow to ~445px. */
  .justified {
    --basis: 280px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 48px;
  }

  .justified .ph {
    display: block;
    flex-grow: var(--r);
    flex-basis: calc(var(--r) * var(--basis));
    aspect-ratio: var(--r);
    background: var(--rule);
  }

  .justified .ph picture { height: 100%; }

  .justified .ph img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 719px) {
    .justified { --basis: 150px; }
  }
</style>
