---
import { SITE, type Lang } from '../lib/site';

interface Props {
  /** The page's language: the labels are English, so they are marked as such on other pages. */
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer wrap mono">
  <p>© {year} {SITE.author}</p>
  <ul class="links" lang={lang === 'en' ? undefined : 'en'}>
    <li><a href={SITE.mailto}>Email</a></li>
    <li><a href="/feed.xml">RSS</a></li>
  </ul>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: 120px;
    padding-block: 24px 32px;
    border-top: 1px solid var(--rule);
    color: var(--muted);
  }

  .links {
    display: flex;
    gap: 24px;
    padding: 0;
    list-style: none;
  }

  /* Padded to a 24 px target; the margin keeps the row where it was. */
  .links a {
    display: inline-block;
    padding-block: 5px;
    margin-block: -5px;
    transition: color 120ms ease;
  }

  .links a:hover { color: var(--fg); }
</style>
