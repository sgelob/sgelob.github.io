---
import Pic from './Pic.astro';
import { artistLabel, byKind, groupByLetter, RECORDS_LEAD, recordPath, type RecordFilter } from '../lib/records';
import { records } from '../lib/records-data';

interface Props {
  filter: RecordFilter;
}

const { filter } = Astro.props;
const filters: { slug: RecordFilter; name: string; href: string }[] = [
  { slug: 'all', name: 'All', href: '/records/' },
  { slug: 'vinyl', name: 'Vinyl', href: '/records/vinyl/' },
  { slug: 'cd', name: 'CD', href: '/records/cd/' },
];
const groups = groupByLetter(byKind(records, filter));
---

<header class="records-header wrap">
  <h1 class="heading">Records</h1>
  <p class="description">{RECORDS_LEAD}</p>
  <nav aria-label="Formats">
    <ul class="filters mono">
      {filters.map(({ slug, name, href }) => (
        <li>
          <a href={href} aria-current={slug === filter ? 'page' : undefined}>{name} <span class="count">{byKind(records, slug).length}</span></a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<div class="records wrap">
  {groups.map(({ letter, records: list }, i) => (
    <section aria-labelledby={`letter-${i}`}>
      <h2 id={`letter-${i}`} class="letter mono">{letter}</h2>
      <ul class="list">
        {list.map((record) => (
          <li class="record-row">
            <a href={recordPath(record)}>
              {record.cover ? (
                <Pic src={record.cover.src} width={record.cover.width} height={record.cover.height} alt="" sizes="44px" maxWidth={480} class="cover" />
              ) : (
                <span class="cover blank" />
              )}
              <span class="name">
                <span class="artist">{artistLabel(record.artist)}</span> <span class="title">— {record.title}</span>
              </span>
              <span class="meta mono">{[record.format, record.year].filter(Boolean).join(' · ')}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .records-header { padding-block: 72px 40px; }

  .heading {
    font-size: 28px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .description {
    max-width: 900px;
    margin-top: 16px;
    color: var(--muted);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin-top: 48px;
    padding: 0;
    list-style: none;
  }

  .filters a {
    display: inline-block;
    padding: 6px 0 3px;
    margin-top: -6px;
    border-bottom: 1px solid transparent;
    color: var(--muted);
    transition: color 120ms ease;
  }

  .filters a:hover,
  .filters a[aria-current] { color: var(--fg); }

  .filters a[aria-current] { border-bottom-color: currentColor; }

  /* Dimmed only beside the current filter, in the light text: on the muted links it fell under 4.5:1 (WCAG 1.4.3). */
  .filters a[aria-current] .count { opacity: 0.7; }

  .records { max-width: calc(900px + 2 * var(--gutter)); padding-bottom: 96px; }

  .letter {
    margin: 32px 0 4px;
    color: var(--muted);
  }

  .list { padding: 0; margin: 0; list-style: none; }

  .record-row a {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto;
    gap: 14px;
    align-items: center;
    padding-block: 8px;
    border-top: 1px solid var(--rule);
    transition: color 120ms ease;
  }

  .record-row a:hover .artist { color: var(--muted); }

  .record-row :global(.cover),
  .cover.blank {
    display: block;
    width: 44px;
    height: 44px;
    object-fit: cover;
    background: var(--rule);
  }

  .name { min-width: 0; overflow-wrap: anywhere; }

  .title { color: var(--muted); }

  .meta { color: var(--muted); white-space: nowrap; }

  @media (max-width: 719px) {
    .records-header { padding-block: 40px 24px; }
    .heading { font-size: 22px; }
    .filters { margin-top: 32px; gap: 10px 20px; }
    .record-row a { grid-template-columns: 44px minmax(0, 1fr); }
    .meta { grid-column: 2; white-space: normal; }
  }
</style>
