---
import { postPath, type Post } from '../lib/paths';
import { formatDate, isoDate } from '../lib/site';
import { categories, categoryName } from '../lib/taxonomies';
import { blogFilters } from '../lib/blog-filters';
import { getPosts } from '../lib/collections';

interface Props {
  posts: Post[];
  /** Rendered as the page's h1. */
  heading?: string;
  /** One-line introduction under the heading (muted). HTML, written by us: it may carry a `lang` span. */
  lead?: string;
  /** Inside another page's section (the home): no page padding, no heading, post titles as h3. */
  embedded?: boolean;
  /** Shows the row of category filters, with this one current: `all` on /blog/, a category slug on its page. */
  filter?: string;
  /** On a category page: a breadcrumb above the heading says it is a category of the blog. */
  crumb?: boolean;
}

const { posts, heading, lead, embedded = false, filter, crumb = false } = Astro.props;
const filters = filter && !embedded ? blogFilters(await getPosts(), categories) : [];
// Embedded, the list sits under its section's h2.
const Title = embedded ? 'h3' : 'h2';
---

<section class:list={['post-list wrap', { embedded }]}>
  {crumb && !embedded && (
    <nav class="crumb mono" aria-label="Breadcrumb" lang="en"><a href="/blog/">Blog</a> <span aria-hidden="true">/</span> Category</nav>
  )}
  {heading && !embedded && <h1 class="heading">{heading}</h1>}
  {lead && !embedded && <p class="lead" set:html={lead} />}
  {filters.length > 0 && (
    <nav aria-label="Categories">
      <ul class="filters mono">
        {filters.map(({ slug, name, href, count }) => (
          <li>
            <a href={href} aria-current={slug === filter ? 'page' : undefined}>{name} <span class="count">{count}</span></a>
          </li>
        ))}
      </ul>
    </nav>
  )}
  {posts.length === 0 ? (
    <p class="mono">No posts yet.</p>
  ) : (
    posts.map((post) => (
      <article class="post-item" lang={post.data.lang}>
        <p class="meta mono">
          <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date, 'it')}</time>
          {post.data.categories.length > 0 && <span> · {post.data.categories.map(categoryName).join(', ')}</span>}
        </p>
        <Title class="title"><a href={postPath(post)}>{post.data.title}</a></Title>
        <p class="excerpt">{post.data.excerpt}</p>
      </article>
    ))
  )}
</section>

<style>
  .post-list {
    max-width: calc(760px + 2 * var(--gutter));
    padding-block: 72px 96px;
  }

  .embedded { padding-block: 0; }

  .embedded .post-item:first-child { border-top: 0; padding-top: 0; }

  .crumb { margin-bottom: 16px; color: var(--muted); }

  .crumb a { border-bottom: 1px solid currentColor; transition: color 120ms ease; }

  .crumb a:hover { color: var(--fg); }

  .lead { margin: -24px 0 40px; color: var(--muted); font-size: 17px; line-height: 1.5; max-width: 60ch; }

  .lead :global(a) { border-bottom: 1px solid currentColor; transition: color 120ms ease; }

  .lead :global(a:hover) { color: var(--fg); }

  .heading {
    margin-bottom: 40px;
    font-size: 28px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  /* The same row as on /outdoors/ and /records/. */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin: 0 0 40px;
    padding: 0;
    list-style: none;
  }

  /* 6 px above the text, cancelled by the margin, makes a 24 px target without moving the row. */
  .filters a {
    display: inline-block;
    padding: 6px 0 3px;
    margin-top: -6px;
    border-bottom: 1px solid transparent;
    color: var(--muted);
    transition: color 120ms ease;
  }

  .filters a:hover,
  .filters a[aria-current] { color: var(--fg); }

  .filters a[aria-current] { border-bottom-color: currentColor; }

  /* Dimmed only beside the current filter, in the light text: on the muted links it would fall under 4.5:1 (WCAG 1.4.3). */
  .filters a[aria-current] .count { opacity: 0.7; }

  .post-item {
    padding-block: 24px;
    border-top: 1px solid var(--rule);
  }

  .post-item:last-child { border-bottom: 1px solid var(--rule); }

  .meta { color: var(--muted); }

  .title {
    margin-top: 8px;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .title a { transition: color 120ms ease; }

  .title a:hover { color: var(--muted); }

  .excerpt {
    margin-top: 6px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
  }

  .post-list > .mono { color: var(--muted); }
  @media (max-width: 719px) {
    .post-list { padding-block: 40px 64px; }
    .heading { font-size: 22px; }
  }
</style>
