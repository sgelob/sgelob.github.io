---
import { postPath, type Post } from '../lib/paths';
import { formatDate, isoDate } from '../lib/site';
import { categoryName } from '../lib/taxonomies';

interface Props {
  posts: Post[];
  /** Rendered as the page's h1. */
  heading?: string;
}

const { posts, heading } = Astro.props;
---

<section class="post-list wrap">
  {heading && <h1 class="heading">{heading}</h1>}
  {posts.length === 0 ? (
    <p class="mono">No posts yet.</p>
  ) : (
    posts.map((post) => (
      <article class="post-item">
        <p class="meta mono">
          <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date, 'it')}</time>
          {post.data.categories.length > 0 && <span> · {post.data.categories.map(categoryName).join(', ')}</span>}
        </p>
        <h2 class="title"><a href={postPath(post)}>{post.data.title}</a></h2>
        <p class="excerpt">{post.data.excerpt}</p>
      </article>
    ))
  )}
</section>

<style>
  .post-list {
    max-width: calc(760px + 2 * var(--gutter));
    padding-block: 72px 96px;
  }

  .heading {
    margin-bottom: 40px;
    font-size: 28px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .post-item {
    padding-block: 24px;
    border-top: 1px solid var(--rule);
  }

  .post-item:last-child { border-bottom: 1px solid var(--rule); }

  .meta { color: var(--muted); }

  .title {
    margin-top: 8px;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .title a { transition: color 120ms ease; }

  .title a:hover { color: var(--muted); }

  .excerpt {
    margin-top: 6px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
  }

  .post-list > .mono { color: var(--muted); }
</style>
