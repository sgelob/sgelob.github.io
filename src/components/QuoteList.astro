---
import { groupByAuthor, quoteAuthorPath, type Quote } from '../lib/quotes';

interface Props {
  quotes: Quote[];
  /** Level of the per-author headings (anchored by author slug); `false` leaves them out (a single author's page). */
  headingLevel?: 2 | 3 | false;
}

const { quotes, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 3 ? 'h3' : 'h2';
---

<div class="quote-list">
  {groupByAuthor(quotes).map(({ author, quotes: authorQuotes }) => (
    <section class="group">
      {headingLevel !== false && (
        <Heading id={author.slug} class="author mono"><a href={quoteAuthorPath(author)}>{author.name}</a></Heading>
      )}
      {authorQuotes.map((quote) => (
        <blockquote class="quote"><p>{quote.text}</p></blockquote>
      ))}
    </section>
  ))}
</div>

<style>
  .quote-list .group {
    padding-block: 24px;
    border-top: 1px solid var(--rule);
  }

  .quote-list .group:last-child { border-bottom: 1px solid var(--rule); }

  .quote-list .author {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.08em;
    scroll-margin-top: 24px;
  }

  .quote-list .author a { transition: color 120ms ease; }

  .quote-list .author a:hover { color: var(--fg); }

  .quote-list .quote {
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--fg);
    font-size: 17px;
    line-height: 1.5;
  }

  .quote-list .quote + .quote { margin-top: 12px; }
</style>
