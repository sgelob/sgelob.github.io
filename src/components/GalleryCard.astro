---
import Pic from './Pic.astro';
import { coverSize, galleryPath, type Gallery } from '../lib/paths';
import { countryName } from '../lib/taxonomies';

interface Props {
  gallery: Gallery;
}

const { gallery } = Astro.props;
const { title, shortTitle, cover, country, date } = gallery.data;

const size = coverSize(gallery);
---

<a class="gallery-card" href={galleryPath(gallery)}>
  <Pic
    src={cover}
    width={size?.width}
    height={size?.height}
    alt=""
    sizes="(min-width: 1100px) 25vw, (min-width: 640px) 50vw, 100vw"
    maxWidth={960}
  />
  <span class="caption mono">
    <span class="title">{shortTitle ?? title}</span>
    <span class="meta">{countryName(country)} · {date.getFullYear()}</span>
  </span>
</a>

<style>
  .gallery-card {
    display: block;
  }

  .gallery-card :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--rule);
    transition: opacity 160ms ease;
  }

  .gallery-card:hover :global(img) { opacity: 0.85; }

  /* In a narrow card the meta drops under the title, and a long word breaks instead of overflowing. */
  .caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 16px;
    margin-top: 12px;
  }

  .title,
  .meta {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .meta { color: var(--muted); }
</style>
