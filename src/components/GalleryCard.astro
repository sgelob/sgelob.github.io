---
import Pic from './Pic.astro';
import { galleryPath, type Gallery } from '../lib/paths';
import { countryName } from '../lib/taxonomies';

interface Props {
  gallery: Gallery;
}

const { gallery } = Astro.props;
const { title, shortTitle, cover, country, date, photos } = gallery.data;

// A few covers are not among their gallery's photos, so their size is unknown. A nominal
// 4:3 size below every variant width makes Pic serve the original, which always exists.
const UNSIZED = { width: 4, height: 3 };
const { width, height } = photos.find((p) => p.src === cover) ?? UNSIZED;
---

<a class="gallery-card" href={galleryPath(gallery)}>
  <Pic
    src={cover}
    width={width}
    height={height}
    alt={title}
    sizes="(min-width: 1100px) 25vw, (min-width: 640px) 50vw, 100vw"
    maxWidth={960}
  />
  <span class="caption mono">
    <span class="title">{shortTitle ?? title}</span>
    <span class="meta">{countryName(country)} · {date.getFullYear()}</span>
  </span>
</a>

<style>
  .gallery-card {
    display: block;
  }

  .gallery-card :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--rule);
    transition: opacity 160ms ease;
  }

  .gallery-card:hover :global(img) { opacity: 0.85; }

  .caption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-top: 12px;
  }

  .meta {
    flex-shrink: 0;
    color: var(--muted);
  }
</style>
