---
import { largestVariantUrl, originalUrl, srcset, WIDTHS } from '../lib/images';

interface Props {
  src: string;
  /** Intrinsic size; when unknown, the original is served without size or srcset. */
  width?: number;
  height?: number;
  alt: string;
  sizes: string;
  maxWidth?: number;
  loading?: 'lazy' | 'eager';
  /** `high` for the page's LCP image, so the browser fetches it ahead of fonts and other images. */
  fetchpriority?: 'high';
  class?: string;
}

const { src, width, height, alt, sizes, maxWidth, loading = 'lazy', fetchpriority, class: className } = Astro.props;

// Variants are never upscaled, so none exists above the image's own width. Of an image narrower
// than the smallest variant, or of unknown size, only the original exists: the srcset comes out empty.
const limit = width === undefined || height === undefined ? 0 : Math.min(maxWidth ?? width, width);
const largest = WIDTHS.filter((w) => w <= limit).at(-1);
// An image narrower than `maxWidth` but wider than its largest variant (a 1440 px cover shown up to
// 1600) would never be served above that variant: the original fills the gap, as the widest candidate.
const original = width !== undefined && largest !== undefined && width < (maxWidth ?? width) && width > largest;
// The original goes into the webp source too: the type only tells browsers without webp to skip
// the source, and an image is decoded by its content, so a jpg candidate there loads fine.
const webp = srcset(src, 'webp', limit) + (original ? `, ${originalUrl(src)} ${width}w` : '');
// Every current browser picks the webp source; the img alone, at the widest jpg variant (or the
// original), is the fallback for the rest. A jpg srcset as well would double the markup of photo-heavy pages.
const fallback = original ? originalUrl(src) : largestVariantUrl(src, limit);
---

<picture>
  {webp && <source type="image/webp" srcset={webp} sizes={sizes} />}
  <img
    src={fallback}
    width={width}
    height={height}
    alt={alt}
    loading={loading}
    fetchpriority={fetchpriority}
    class={className}
  />
</picture>
