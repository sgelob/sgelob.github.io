---
import { WIDTHS, originalUrl, srcset, variantUrl } from '../lib/images';

interface Props {
  src: string;
  width: number;
  height: number;
  alt: string;
  sizes: string;
  maxWidth?: number;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { src, width, height, alt, sizes, maxWidth = width, loading = 'lazy', class: className } = Astro.props;

// Variants are never upscaled, so none exists above the image's own width.
const limit = Math.min(maxWidth, width);
const webp = srcset(src, 'webp', limit);
const jpg = srcset(src, 'jpg', limit);
const largest = WIDTHS.filter((w) => w <= limit).at(-1);
// Images narrower than the smallest variant only exist as the original.
const fallback = largest === undefined ? originalUrl(src) : variantUrl(src, largest, 'jpg');
---

<picture>
  {webp && <source type="image/webp" srcset={webp} sizes={sizes} />}
  <img
    src={fallback}
    srcset={jpg || undefined}
    sizes={jpg ? sizes : undefined}
    width={width}
    height={height}
    alt={alt}
    loading={loading}
    decoding="async"
    class={className}
  />
</picture>
